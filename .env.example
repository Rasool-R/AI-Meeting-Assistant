APP_NAME="AI Meeting Assistant"
APP_ENV="development"
APP_VERSION="0.1.0"
API_V1_PREFIX="/api/v1"
LOG_LEVEL="INFO"

# Database configuration (SQLite for local dev; PostgreSQL for Docker/production)
# Example PostgreSQL URL: postgresql+psycopg://postgres:postgres@localhost:5432/meeting_assistant
DATABASE_URL="sqlite:///./meeting_assistant.db"

# Media upload and storage settings (50 MB default max upload size)
MEDIA_STORAGE_DIR="storage/media"
MAX_UPLOAD_SIZE_BYTES="52428800"

# Language settings: fa (Persian), en (English), mixed (Code-switched Persian/English)
DEFAULT_MEETING_LANGUAGE="mixed"
SUPPORTED_LANGUAGES="fa,en,mixed"